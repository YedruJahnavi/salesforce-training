public with sharing class StudentProfileController {

    @AuraEnabled(cacheable=true)
    public static Student__c getStudent() {

        return [
            SELECT Id,
                   Name,
                   Phone_Number__c,
                   Email__c,
                   DOB__c,
                   Department__c,
                   CGPA__c
            FROM Student__c
            WHERE Name = 'JAHNAVI'
            LIMIT 1
        ];
    }

    @AuraEnabled
    public static Student__c updateStudent(
        Id studentId,
        String phoneNumber,
        String email,
        Date dob,
        String department,
        Decimal cgpa
    ) {

        if (String.isBlank(phoneNumber)) {

            throw new AuraHandledException(
                'Phone Number is required.'
            );
        }

        if (String.isBlank(email)) {

            throw new AuraHandledException(
                'Email is required.'
            );
        }

        if (String.isBlank(department)) {

            throw new AuraHandledException(
                'Department is required.'
            );
        }

        if (
            cgpa == null ||
            cgpa < 0 ||
            cgpa > 10
        ) {

            throw new AuraHandledException(
                'CGPA must be between 0 and 10.'
            );
        }

        Student__c student = [
            SELECT Id,
                   Name,
                   Phone_Number__c,
                   Email__c,
                   DOB__c,
                   Department__c,
                   CGPA__c
            FROM Student__c
            WHERE Id = :studentId
            LIMIT 1
        ];

        student.Phone_Number__c = phoneNumber;
        student.Email__c = email;
        student.DOB__c = dob;
        student.Department__c = department;
        student.CGPA__c = cgpa;

        update student;

        return student;
    }
}
