// eligibleJobs.js

import { LightningElement, wire } from 'lwc';

import getEligibleJobs
    from '@salesforce/apex/EligibleJobsController.getEligibleJobs';

import submitApplication
    from '@salesforce/apex/ApplicationController.submitApplication';

export default class EligibleJobs extends LightningElement {

    jobs = [];

    @wire(getEligibleJobs)
    wiredJobs(result) {

        if (result.data) {

            this.jobs = result.data.map(job => {

                return {
                    ...job,
                    isSubmitting: false,
                    isApplied: false,
                    successMessage: '',
                    errorMessage: ''
                };

            });

        } else if (result.error) {

            console.error(result.error);

            this.jobs = [];
        }
    }

    async handleApply(event) {

        const jobId = event.detail.jobId;

        // Set only the clicked job to submitting
        this.jobs = this.jobs.map(job => {

            if (job.Id === jobId) {

                return {
                    ...job,
                    isSubmitting: true,
                    successMessage: '',
                    errorMessage: ''
                };

            }

            return job;
        });

        try {

            const applicationId = await submitApplication({
                jobId: jobId
            });

            console.log('Application Id:', applicationId);

            // Update only the clicked job
            this.jobs = this.jobs.map(job => {

                if (job.Id === jobId) {

                    return {
                        ...job,
                        isSubmitting: false,
                        isApplied: true,
                        successMessage:
                            'Application submitted successfully.',
                        errorMessage: ''
                    };

                }

                return job;
            });

        } catch (error) {

            console.error('Application error:', error);

            let message =
                'We could not submit your application.';

            if (
                error &&
                error.body &&
                error.body.message
            ) {

                message = error.body.message;
            }

            // Show error only for the clicked job
            this.jobs = this.jobs.map(job => {

                if (job.Id === jobId) {

                    return {
                        ...job,
                        isSubmitting: false,
                        errorMessage: message,
                        successMessage: ''
                    };

                }

                return job;
            });
        }
    }
}


