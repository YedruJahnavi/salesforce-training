//jobCard.js


import { LightningElement, api } from 'lwc';

export default class JobCard extends LightningElement {

    @api job;

    handleApply() {

        const applyEvent = new CustomEvent('apply', {
            detail: {
                jobId: this.job.Id
            }
        });

        this.dispatchEvent(applyEvent);
    }

    get applyButtonLabel() {

        if (this.job.isApplied) {
            return 'Applied';
        }

        if (this.job.isSubmitting) {
            return 'Submitting...';
        }

        return 'Apply';
    }

    get applyButtonDisabled() {

        return this.job.isApplied ||
               this.job.isSubmitting;
    }
}


