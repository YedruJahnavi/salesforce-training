// EligibleJobsController.cls

  
public with sharing class EligibleJobsController {
    @AuraEnabled(cacheable=true)
    public static List<Job__c> getEligibleJobs() {

        return [
            SELECT Id,
                   Name,
                   Company__c,
                   Location__c,
                   Closing_Date__c,
                   Minimum_CGPA__c,
                   Salary__c
            FROM Job__c
            ORDER BY Closing_Date__c ASC
        ];
    }
}
