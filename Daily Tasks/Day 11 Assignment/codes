@IsTest
private class ApplicationTriggerTest {

    private class RecruitmentApiMock implements HttpCalloutMock {

        public Integer calloutCount = 0;

        public HttpResponse respond(HttpRequest request) {

            calloutCount++;

            HttpResponse response = new HttpResponse();

            if (calloutCount == 1) {

                response.setStatusCode(201);

                response.setHeader(
                    'Content-Type',
                    'application/json'
                );

                response.setBody(
                    '{"id":101,"title":"Candidate Created"}'
                );

            } else {

                response.setStatusCode(500);

                response.setHeader(
                    'Content-Type',
                    'application/json'
                );

                response.setBody(
                    '{"error":"Duplicate submission detected"}'
                );
            }

            return response;
        }
    }

    @IsTest
    static void testApplicationTriggerQueuesCandidateSync() {

        Student__c student = new Student__c(
            Name = 'Trigger Test Student',
            Email__c = 'triggertest@example.com',
            Department__c = 'CSE',
            CGPA__c = 8.5
        );

        insert student;

        Job__c job = new Job__c(
            Name = 'Salesforce Developer',
            Company__c = 'Test Company'
        );

        insert job;

        Schema.DescribeFieldResult statusField =
            Application__c.Status__c.getDescribe();

        String initialStatus;

        for (
            Schema.PicklistEntry entry :
            statusField.getPicklistValues()
        ) {

            if (
                entry.isActive() &&
                entry.getValue() != 'Selected'
            ) {

                initialStatus = entry.getValue();
                break;
            }
        }

        System.assertNotEquals(
            null,
            initialStatus,
            'A non-Selected Application Status value is required.'
        );

        Application__c applicationRecord =
            new Application__c(
                Student__c = student.Id,
                Job__c = job.Id,
                Status__c = initialStatus,
                Application_Date__c = Date.today(),
                Integration_Status__c = 'Pending'
            );

        insert applicationRecord;

        RecruitmentApiMock mock =
            new RecruitmentApiMock();

        Test.setMock(
            HttpCalloutMock.class,
            mock
        );

        Test.startTest();

        applicationRecord.Status__c = 'Selected';

        update applicationRecord;

        Test.stopTest();

        Application__c result = [
            SELECT Status__c,
                   Integration_Status__c,
                   External_Candidate_Id__c,
                   Integration_Error__c,
                   Last_Integration_Attempt__c
            FROM Application__c
            WHERE Id = :applicationRecord.Id
        ];

        System.assertEquals(
            'Selected',
            result.Status__c
        );

        System.assertEquals(
            'Sent',
            result.Integration_Status__c
        );

        System.assertEquals(
            '101',
            result.External_Candidate_Id__c
        );

        System.assertEquals(
            null,
            result.Integration_Error__c
        );

        System.assertNotEquals(
            null,
            result.Last_Integration_Attempt__c
        );

        System.assertEquals(
            1,
            mock.calloutCount
        );
    }

    @IsTest
    static void testDuplicateCandidateIsNotSubmitted() {

        Student__c student = new Student__c(
            Name = 'Duplicate Test Student',
