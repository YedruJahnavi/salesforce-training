### 1. `CandidateSyncQueueable.cls`

```apex
public class CandidateSyncQueueable implements Queueable, Database.AllowsCallouts {

    private Id applicationId;

    public CandidateSyncQueueable(Id applicationId) {
        this.applicationId = applicationId;
    }

    public void execute(QueueableContext context) {

        Application__c applicationRecord = [
            SELECT Id,
                   Name,
                   Status__c,
                   Application_Date__c,
                   Integration_Status__c,
                   External_Candidate_Id__c,
                   Last_Integration_Attempt__c,
                   Integration_Error__c,
                   Student__c,
                   Student__r.Name,
                   Student__r.Email__c,
                   Student__r.Department__c,
                   Student__r.CGPA__c,
                   Job__c,
                   Job__r.Name,
                   Job__r.Company__c
            FROM Application__c
            WHERE Id = :applicationId
            LIMIT 1
        ];

        applicationRecord.Last_Integration_Attempt__c = System.now();
        applicationRecord.Integration_Status__c = 'Pending';
        applicationRecord.Integration_Error__c = null;

        Map<String, Object> candidate = new Map<String, Object>();

        candidate.put('studentId', String.valueOf(applicationRecord.Student__c));
        candidate.put('name', applicationRecord.Student__r.Name);
        candidate.put('email', applicationRecord.Student__r.Email__c);
        candidate.put('branch', applicationRecord.Student__r.Department__c);
        candidate.put('cgpa', applicationRecord.Student__r.CGPA__c);
        candidate.put('jobId', String.valueOf(applicationRecord.Job__c));
        candidate.put('company', applicationRecord.Job__r.Company__c);
        candidate.put('role', applicationRecord.Job__r.Name);
        candidate.put('selectionDate', applicationRecord.Application_Date__c);

        HttpRequest request = new HttpRequest();

        request.setEndpoint('callout:Recruitment_API/posts');
        request.setMethod('POST');
        request.setHeader('Content-Type', 'application/json');
        request.setBody(JSON.serialize(candidate));

        try {

            Http http = new Http();
            HttpResponse response = http.send(request);

            Integer statusCode = response.getStatusCode();
            String responseBody = response.getBody();

            if (statusCode == 200 || statusCode == 201) {

                Map<String, Object> responseData =
                    (Map<String, Object>)
                    JSON.deserializeUntyped(responseBody);

                if (responseData.containsKey('id')) {
                    applicationRecord.External_Candidate_Id__c =
                        String.valueOf(responseData.get('id'));
                }

                applicationRecord.Integration_Status__c = 'Sent';
                applicationRecord.Integration_Error__c = null;

            } else if (statusCode == 400) {

                applicationRecord.Integration_Status__c = 'Failed';
                applicationRecord.Integration_Error__c =
                    'Bad Request: ' + responseBody;

            } else if (statusCode == 401) {

                applicationRecord.Integration_Status__c = 'Failed';
                applicationRecord.Integration_Error__c =
                    'Authentication Failed: ' + responseBody;

            } else if (statusCode == 403) {

                applicationRecord.Integration_Status__c = 'Failed';
                applicationRecord.Integration_Error__c =
                    'Forbidden: ' + responseBody;

            } else if (statusCode == 500) {

                applicationRecord.Integration_Status__c = 'Retry Required';
                applicationRecord.Integration_Error__c =
                    'External Server Error: ' + responseBody;

            } else {

                applicationRecord.Integration_Status__c = 'Failed';
                applicationRecord.Integration_Error__c =
                    'Unexpected Response (' +
                    statusCode +
                    '): ' +
                    responseBody;
            }

        } catch (Exception e) {

            applicationRecord.Integration_Status__c = 'Retry Required';
            applicationRecord.Integration_Error__c = e.getMessage();
        }

        update applicationRecord;
    }
}
